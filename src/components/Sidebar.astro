---
import data from '../data/portfolio.json';
import ThemeToggle from './ThemeToggle.astro';

const { profile, contact } = data;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const initials = profile.name.split(' ').map((w) => w[0]).join('').slice(0, 2);
const photoSrc = profile.photo ? `${base}${profile.photo.replace(/^\//, '')}` : '';

const sections = [
  ['experience', 'Experience'],
  ['work', 'Work'],
  ['teaching', 'Teaching'],
  ['skills', 'Skills'],
  ['education', 'Education'],
  ['contact', 'Contact'],
];
---
<aside class="side">
  <div class="side-top">
    <div class="avatar" aria-hidden={photoSrc ? undefined : 'true'}>
      {photoSrc ? <img src={photoSrc} alt={profile.name} /> : initials}
    </div>
    <ThemeToggle />
  </div>

  <div>
    <h1>{profile.name}</h1>
    <p class="role">{profile.role}</p>
  </div>

  <p class="summary">{profile.summary}</p>
  {profile.available && <span class="status">{profile.available}</span>}

  <nav class="nav" aria-label="Sections">
    {sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>

  <div class="links">
    {profile.cv && (
      <a class="cv" href={`${base}${profile.cv}`} download={`${profile.name.replace(/\s+/g, '-')}-CV.pdf`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14" /></svg>
        Download CV
      </a>
    )}
    {contact.linkedin && <a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>}
    {contact.github && <a href={contact.github} target="_blank" rel="noopener">GitHub ↗</a>}
    {contact.email && <a href={`mailto:${contact.email}`}>Email</a>}
  </div>
</aside>
