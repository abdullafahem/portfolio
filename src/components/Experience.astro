---
import data from '../data/portfolio.json';
import Section from './Section.astro';

// Short commit-style hash made from the job title, for the git-log look
function hash(s: string) {
  let h = 5381;
  for (const ch of s) h = ((h << 5) + h + ch.charCodeAt(0)) >>> 0;
  return h.toString(16).padStart(7, '0').slice(0, 7);
}
const jobs = data.experience;
---
<Section id="experience" title="Experience" note={`${jobs.length} entries`}>
  <div class="log">
    {jobs.map((job) => (
      <article class:list={['commit', { current: job.current }]}>
        <div class="rail"><span class="dot"></span></div>
        <div class="commit-body">
          <div class="meta">
            <span class="hash">{hash(job.company + job.role)}</span>
            <span>{job.start} – {job.end}</span>
            {job.current && <span class="head">● current</span>}
          </div>
          <h3>{job.role}</h3>
          <p class="company"><b>{job.company}</b> · {job.location}</p>
          <ul>
            {job.points.map((p) => <li>{p}</li>)}
          </ul>
          {job.tags.length > 0 && (
            <div class="tags">
              {job.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</Section>
